# ============================================
# OS Process Scheduling Simulator - Git Ignore
# ============================================

# Java / Maven build output
**/target/
**/*.class
**/*.jar
**/*.war
**/*.nar
**/*.ear
**/*.zip
**/*.tar.gz
**/*.rar

# Node / Frontend build output & dependencies
**/node_modules/
**/dist/
**/dist-ssr/
*.local

# Logs
**/logs/
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# IDE and Editor files
.idea/
*.iml
*.iws
*.ipr
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
.project
.classpath
.settings/

# OS specific files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# Temporary files
scratch/
tmp/
temp/
